# Database (Neon / Vercel Postgres)
POSTGRES_PRISMA_URL="postgres://user:password@host:port/database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:port/database?sslmode=require"

# Authentication
# Generate a secret with: openssl rand -base64 32
JWT_SECRET="your-secret-key-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp (Z-API) - Obtenha em https://app.z-api.io
ZAPI_INSTANCE_ID="SUA_INSTANCE_ID"         # Painel Z-API → sua instância → ID da Instância
ZAPI_TOKEN="SEU_TOKEN"                      # Painel Z-API → sua instância → Token
ZAPI_CLIENT_TOKEN="SEU_CLIENT_TOKEN"        # Painel Z-API → Segurança → Client-Token
WHATSAPP_GROUP_ID="120363XXXXXXXXX@g.us"   # ID do grupo (obtenha via Z-API após conectar)

# Cron
CRON_SECRET="uma-chave-segura-aqui"
